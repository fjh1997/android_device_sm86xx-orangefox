cc_library_static {
    name: "libinit_oplus_sm86xx",
    srcs: [
        "libinit_oplus_sm86xx.cpp",  // 正确的源码文件路径（同级目录）
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
    ],
    // 修正 Include 路径：去掉不存在的 "libinit"，使用 Soong 支持的绝对路径（//开头），避免相对路径出错
    local_include_dirs: [
        // 无需 "libinit"（不存在），直接引用上级/系统目录
        "../../../../system/core/init",  // 从 libinit 目录往上4级到根目录，再进入 system/core/init
        "../../../../hardware/libhardware/include",
        "../../../../system/core/base/include",
    ],
    shared_libs: [
        "liblog",
        "libutils",
        "libhardware",
        "libbase",
        "libcutils",
        "libc++",
    ],
    stl: "c++_static",
    // 明确架构适配（匹配报错的 arm64_armv8-a_kryo）
    arch: {
        arm64: {
            variants: ["arm64_armv8-a", "arm64_armv8-a_kryo"],
        },
    },
}
